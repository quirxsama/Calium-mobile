# ============================================================================
# Calium Mobile — Environment Variables Example
# Copy this file to .env and fill in the values
# ============================================================================

# Calium Web Backend (Auth, User Profile, Sync)
CALIUM_BACKEND_URL=https://calium.fun

# Anizium Direct API (Anime Data, Episodes, Streams)
ANIZIUM_API_BASE_URL=https://api.anizium.co

# Anizium Cloudflare Headers
ANIZIUM_CF_CONTROL=your_cf_control_token
ANIZIUM_USER_SESSION=your_user_session_token
ANIZIUM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/139.0.0.0 Safari/537.36

# TMDB API
TMDB_API_KEY=your_tmdb_api_key
